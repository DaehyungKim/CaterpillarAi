    "entities": [
      {
        "start": 5,
        "end": 11,
        "type": "AUTHOR"
      },
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "이용규 책 좀 찾아봐.",
