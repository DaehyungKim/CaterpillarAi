    "entities": [
      {
        "start": 5,
        "end": 8,
        "type": "AUTHOR"
      },
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 제럴드 오콜린스 책 있어?",
