        "start": 5,
        "end": 13,
        "type": "AUTHOR"
      },
      {
        "start": 14,
        "end": 15,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "혹시 오건영 쓴 책은 도서관에 있나요?",
