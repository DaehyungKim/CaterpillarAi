        "start": 3,
        "end": 6,
        "type": "AUTHOR"
      },
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "조성민 저자의 책 좀 찾아줄래?",
