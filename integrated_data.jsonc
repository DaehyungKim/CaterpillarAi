    "entities": [
      {
        "start": 0,
        "end": 2,
        "type": "AUTHOR"
      },
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "법륜의 신간 책을 찾고 있는데 있나요?",
