    "entities": [
      {
        "start": 0,
        "end": 4,
        "type": "BOOK"
      },
      {
        "start": 13,
        "end": 14,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "지금 바로 빌릴 수 있는 책으로 다정한 것이 살아남는다 있을까요?",
    "intent": 1,
    "entities": [
      {
