        "start": 3,
        "end": 4,
        "type": "FORMAT"
      },
      {
        "start": 11,
        "end": 19,
        "type": "BOOK"
      }
    ]
  },
  {
    "text": "J.B. 이라는 제목의 책, 대출 가능한 상태인가요?",
