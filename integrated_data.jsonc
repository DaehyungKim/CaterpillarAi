  //11 희망도서

  {
    "text": "야 나 찾고있는 책이 도서관에 없는데 신청 할 수 있어?",
    "intent": 11,
    "entities": [
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 어케하니?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "희망도서 신청하고 싶은데 어떻게 해야 돼?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "얌마 도서관에 책 신청하고 싶은데",
    "intent": 11,
    "entities": [
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 책 신청하고 싶은데 어떻게 해야 돼?",
    "intent": 11,
    "entities": [
      {
        "start": 5,
        "end": 6,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 방법 알려주세요.",
    "intent": 11,
    "entities": []
  },
  {
    "text": "책 신청은 어떻게 하나요?",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 없는 책은 어떻게 신청하죠?",
    "intent": 11,
    "entities": [
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "원하는 책이 없는데 구매 요청할 수 있나요?",
    "intent": 11,
    "entities": [
      {
        "start": 4,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 절차가 궁금해요.",
    "intent": 11,
    "entities": []
  },
  {
    "text": "신간 도서를 구매 요청하고 싶습니다.",
    "intent": 11,
    "entities": [
      {
        "start": 3,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청하는 법 좀 알려줘.",
    "intent": 11,
    "entities": []
  },
  {
    "text": "홈페이지에서 희망도서 신청 어디서 해요?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "제가 읽고 싶은 책이 도서관에 없어요. 신청 가능한가요?",
    "intent": 11,
    "entities": [
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "찾는 책이 없는데, 희망도서로 신청하면 되나요?",
    "intent": 11,
    "entities": [
      {
        "start": 3,
        "end": 4,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서 구비 신청은 어떤 방식으로 진행되나요?",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 2,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 좀 사주세요. 어떻게 신청하면 돼요?",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 자격이 따로 있나요?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "없는 책 신청하려면 어떻게 해야 하는지 알려줄래?",
    "intent": 11,
    "entities": [
      {
        "start": 3,
        "end": 4,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 신청하는 거 도와줘.",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 가이드라인 좀 볼 수 있을까요?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "도서 신청하는데 제한이 있나요?",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 2,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "소장하고 있지 않은 도서는 어떻게 신청할 수 있습니까?",
    "intent": 11,
    "entities": [
      {
        "start": 11,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "이 도서관에 없는 책을 보고 싶은데, 방법이 없을까요?",
    "intent": 11,
    "entities": [
      {
        "start": 10,
        "end": 11,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 신청 좀 하려고 하는데, 방법 좀.",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "희망도서 신청 ㄱㄴ?",
    "intent": 11,
    "entities": []
  },
  {
    "text": "여기 없는 책 읽고 싶으면 어떡해야 돼?",
    "intent": 11,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서 신청 절차에 대해 문의 드립니다.",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 2,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "찾는 책 없으면 신청할 수 있다며? 어떻게 해?",
    "intent": 11,
    "entities": [
      {
        "start": 3,
        "end": 4,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 책 좀 들여달라고 하고 싶은데 어떡하죠?",
    "intent": 11,
    "entities": [
      {
        "start": 5,
        "end": 6,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 신청하는 메뉴가 어디있어?",
    "intent": 11,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "으아앙, 도서관에 내가 원하는 책이 없어",
    "intent": 11,
    "entities": [
      {
        "start": 17,
        "end": 18,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 없는 책은 어캄?",
    "intent": 11,
    "entities": [
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 없는책 어케하냐?",
    "intent": 11,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  


  

  









  //0 기타
