    "entities": [
      {
        "start": 17,
        "end": 18,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 사람들 뭐 빌리고 댕기냐?",
    "intent": 3,
    "entities": []
  },
  {
    "text": "솔직히 시간 아까우니까 대출 많이 된 책이나 줘봐",
    "intent": 3,
    "entities": []
  },
  {
    "text": "너 책 잘 추천하냐? 대출 순위 높은 거 한 번 보자",
    "intent": 3,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "아 진짜 귀찮게 하지 말고 대출 많이 된 책이나 줘",
    "intent": 3,
    "entities": []
  },
  {
    "text": "도서관 수준 보자, 인기 대출 책 뭐 있는지나 보여줘봐",
    "intent": 3,
    "entities": [
      {
        "start": 17,
        "end": 18,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "챗봇아, 뇌 안 쓰고 싶은데 대출 베스트 리스트 줘",
    "intent": 3,
    "entities": []
  },
  {
    "text": "커뮤에 다들 추천하는 책 뭐냐, 여기선 대출 많이 안 돼?",
    "intent": 3,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 트렌드 책 좀 알고 싶다, 대출 순위 리스트 좀 줘",
    "intent": 3,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "대출 베스트 없으면 실망이야 챗봇아",
    "intent": 3,
    "entities": []
  },
  {
    "text": "내 친구가 추천해달라는데 대출 순위 높은 책 좀 줘봐",
    "intent": 3,
    "entities": [
      {
        "start": 23,
        "end": 24,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "진짜 핫한 책 중에 대출 많이 된 것만 보여줘, 시간 없어",
    "intent": 3,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "너도 책 좀 읽냐? 읽으면 대출 베스트부터 들이대봐",
    "intent": 3,
    "entities": [
      {
        "start": 3,
        "end": 4,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "챗봇이 대출 베스트도 못 보여주냐?",
    "intent": 3,
    "entities": []
  },
  {
    "text": "요즘 챗봇이면 알아서 대출 순위 높은 책 좀 띄워줘야 되는 거 아님?",
    "intent": 3,
    "entities": [
      {
        "start": 21,
        "end": 22,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 좀 보려고 하는데, 제일 대출 많이 된 애들 추천해봐",
    "intent": 3,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "시간 아깝게 하지 말고 그냥 요즘 대출 많이 된 책 알려줘",
    "intent": 3,
    "entities": [
      {
        "start": 27,
        "end": 28,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "커뮤니티에서 핫한 책, 대출도 많이 된 거 여기서 볼 수 있음?",
    "intent": 3,
    "entities": [
      {
        "start": 10,
        "end": 11,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "야 도서관 대출 베스트 알려줘",
    "intent": 3,
    "entities": []
  },
  {
    "text": "대출 베스트 목록 좀 보여줘",
    "intent": 3,
    "entities": []
  },
  {
    "text": "요즘 대출 많이 되는 책 뭐 있어?",
    "intent": 3,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관 대출 베스트 알려주세요.",
    "intent": 3,
    "entities": []
  },
  {
    "text": "현재 대출 순위 높은 책 좀 알 수 있을까요?",
    "intent": 3,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "가장 대출 많이 된 책들 좀 추천해주세요.",
    "intent": 3,
    "entities": [
      {
        "start": 11,
        "end": 12,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관 대출 도서 목록 조회하고 싶어요.",
    "intent": 3,
    "entities": [
      {
        "start": 7,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "지금 대출 많이 된 책들 뭐뭐 있나요?",
    "intent": 3,
    "entities": [
      {
        "start": 11,
        "end": 12,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "인기 대출 도서 목록!",
    "intent": 3,
    "entities": [
      {
        "start": 6,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "지금 도서관에서 뜨는 책들 리스트",
    "intent": 3,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "마 책 한권 까리하게 추천해봐라라",
    "intent": 3,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "책 추천좀 해봐라라",
    "intent": 3,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },

  //4 신간 도서 추천
  
  {
    "text": "신간 추천해 주세요.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 나온 책 뭐 있나요?",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 읽을 만한 신착 도서 알려줘.",
    "intent": 4,
    "entities": [
      {
        "start": 12,
        "end": 14,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신 도서 목록 좀 보여주세요.",
    "intent": 4,
    "entities": [
      {
        "start": 3,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 새로 들어온 책들 궁금해요.",
    "intent": 4,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "어떤 신간들이 있는지 알려줄 수 있나요?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "최근 발간된 책 중에서 추천할 만한 거 있어요?",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "새 책 정보 좀 얻을 수 있을까요?",
    "intent": 4,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 도서들 소개해주세요.",
    "intent": 4,
    "entities": [
      {
        "start": 3,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 핫한 신간은 뭔가요?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관 신착 자료 안내해줘.",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "새로 입고된 책 리스트 부탁해요.",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "읽을 만한 새로운 책 없을까요?",
    "intent": 4,
    "entities": [
      {
        "start": 10,
        "end": 11,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 베스트셀러는 뭐예요?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "이번 달 신간 도서 알려주세요.",
    "intent": 4,
    "entities": [
      {
        "start": 8,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "오늘 들어온 새 책 있어요?",
    "intent": 4,
    "entities": [
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신 출판물 정보 좀 주세요.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 나온 도서들 중에서 볼만한 거 추천해줘.",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관 신간 코너에 뭐 새로운 거 들어왔어?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "신간 소식 좀 알려줄래?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요즘 어떤 책이 새로 나왔어?",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신규 입고 도서 정보 부탁드립니다.",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신작들 중에서 뭐 읽을지 추천 좀.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 들어온 책들 리스트업 해줘.",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 서적 안내 받고 싶어요.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "신간 뭐 있냐? ㅋㅋ",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관아, 신간 나온 거 뭐 있음?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요새 볼만한 새 책 읍나여?",
    "intent": 4,
    "entities": [
      {
        "start": 9,
        "end": 10,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 리스트 쏴주셈.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 들어온 책 정보 좀 주라주라~",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신 도서 뭐 있는지 갈쳐주세요!",
    "intent": 4,
    "entities": [
      {
        "start": 3,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 중에 띵작 각인 거 추천좀.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관 슨생님, 신간 추천 박아주세요.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새 책 구경 좀 하고 싶은데 뭐 있심?",
    "intent": 4,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 ㄱㄱ",
    "intent": 4,
    "entities": []
  },
  {
    "text": "따끈따끈한 신간 있냐고요~",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요즘 인싸들이 보는 신간 뭐임?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관에 새 책 뭐 들어왔는지 스포 좀 ㅎㅎ",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 목록 업데이트 됐나? 보여줘!",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새 책 뭐 나왔는지 썰 좀 풀어봐.",
    "intent": 4,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신 책 중에 건질 거 없나?",
    "intent": 4,
    "entities": [
      {
        "start": 3,
        "end": 4,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 추천 드가자~",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관 픽 신간 알려주면 안됨?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요즘 밀고 있는 신간 있어?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 나온 책들 중 내 취향일 만한 거 추천해줄 수 있음?",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신착 도서 브리핑 부탁요.",
    "intent": 4,
    "entities": [
      {
        "start": 3,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관 봇아, 신간 뭐 있는지 읊어봐라.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "오늘의 신간은 무엇? 궁금궁금",
    "intent": 4,
    "entities": []
  },
  {
    "text": "최신판 책들 정보 공유 좀!",
    "intent": 4,
    "entities": [
      {
        "start": 4,
        "end": 5,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 뭐 나왔는지 체크 좀 해줘.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관에 새로 들어온 책 읎나?",
    "intent": 4,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 핫한 신간 좀 알려주면 안 될까?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "신간 중에 대박템 있을까?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관형, 신간 뭐 있어?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 나온 책 리스트 좀 줘봐.",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 중에 읽을 만한 거 뭐 있냐고 묻습니다.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "신간 정보 좀 뿌려줘.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관에 신상 책 들어왔는지 알려줭.",
    "intent": 4,
    "entities": [
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "최신작 중에 뭐 볼까 고민 중인데 신간 추천 좀.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요새 뭐 새 책 들어온 거 없슈?",
    "intent": 4,
    "entities": [
      {
        "start": 7,
        "end": 8,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 신삥 책 뭐 있는지 좀 보자.",
    "intent": 4,
    "entities": [
      {
        "start": 8,
        "end": 9,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 중에 뭐 좀 괜찮은 거 나왔나?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관 신간 코너에 먼지 좀 털었나? 뭐 새로운 거 없어?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "따끈한 신간 소식 좀 전해주라, 챗봇아.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "나 심심한데, 신간 중에 킬링타임용 뭐 없냐?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요즘 서가에 새로 꽂힌 책 뭐임?",
    "intent": 4,
    "entities": [
      {
        "start": 13,
        "end": 14,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관 최신 입고 리스트 갱신됐으면 공유 좀.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "내 영혼을 살찌울 새로운 책은 어디에...",
    "intent": 4,
    "entities": [
      {
        "start": 14,
        "end": 15,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 뭐 있나 쓱 한번 훑어보게 리스트 주라.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "도서관 님아, 신간 중에 힙한 거 있음?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새 책 냄새 맡고 싶은데, 뭐 추천할 거 없소?",
    "intent": 4,
    "entities": [
      {
        "start": 2,
        "end": 3,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "요즘 출판계 동향은 어떤가? 신간으로 보여줘.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "책 좀 읽어볼까 하는데, 뭐부터 봐야 할지... 신간 중에 골라줘.",
    "intent": 4,
    "entities": [
      {
        "start": 0,
        "end": 1,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 뉴페이스 책 등장했으면 알려줘.",
    "intent": 4,
    "entities": [
      {
        "start": 10,
        "end": 11,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 중에 눈에 띄는 거 있으면 좀 찔러줘 봐.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "책덕후 설레게 할 만한 신간 소식 없나요?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "오늘 막 들어온 따끈따끈한 책 뭐 있는지 알려줄 사람~",
    "intent": 4,
    "entities": [
      {
        "start": 15,
        "end": 16,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 최근 등록된 책 목록 좀 주시오.",
    "intent": 4,
    "entities": [
      {
        "start": 12,
        "end": 13,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 뭐 나왔는지 업데이트 좀 해봐.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "요즘 대세 신간은 뭐길래 다들 난리임?",
    "intent": 4,
    "entities": []
  },
  {
    "text": "새로 나온 책 중에서 흥미로운 거 뭐 없을까나?",
    "intent": 4,
    "entities": [
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 추천 한방 부탁드립니다.",
    "intent": 4,
    "entities": []
  },
  {
    "text": "이번에 새로 입고된 책들 중에서 꿀잼각 나오는 거 뭐임?",
    "intent": 4,
    "entities": [
      {
        "start": 11,
        "end": 12,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "신간 중에서 지름신 올 만한 책 추천해주면 복 받을겨.",
    "intent": 4,
    "entities": [
      {
        "start": 16,
        "end": 17,
        "type": "FORMAT"
      }
    ]
  },

