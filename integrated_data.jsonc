    "entities": [
      {
        "start": 0,
        "end": 2,
        "type": "AUTHOR"
      },
      {
        "start": 6,
        "end": 7,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "도서관에 데이비드 이글먼 책 있어?",
