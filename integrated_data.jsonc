  //6 회원대출

  {
    "text": "나 지금 책 몇권 빌렸냐?",
    "intent": 6,
    "entities": [
      {
        "start": 5,
        "end": 6,
        "type": "FORMAT"
      }
    ]
  },
  {
    "text": "마 대출목록 함 씩씩하게 뽑아봐라",
    "intent": 6,
    "entities": []
  },
  {
    "text": "나 연체 있어?",
    "intent": 6,
    "entities": []
  },
